APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL only — the app uses PG-specific SQL (make_interval, FILTER, ilike).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis backs the queue, the cache, and Horizon — the run engine's locks and
# control signals live in the cache, so it must be shared across workers.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated emails allowed into the Horizon dashboard outside local.
HORIZON_AUTHORIZED_EMAILS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Game client. The throttle is a jittered per-character gap between game
# requests — lower it only if you know what the game tolerates.
OUTWAR_LOGIN_HOST=https://outwar.com
OUTWAR_HTTP_TIMEOUT=12
OUTWAR_HTTP_CONNECT_TIMEOUT=5
OUTWAR_HTTP_RETRY_TIMES=3
OUTWAR_HTTP_RETRY_SLEEP_MS=500
OUTWAR_THROTTLE_MIN_MS=300
OUTWAR_THROTTLE_MAX_MS=800
OUTWAR_BRAWL_ATTACKS_VERIFIED=false
